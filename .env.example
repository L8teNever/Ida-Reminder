# Kopieren nach ".env" und ausfuellen. ".env" NIEMALS committen.

# --- Zeitzone & Timing ---
# IANA-Zeitzone fuer zeitpunkt-Angaben ohne Offset (siehe README).
TIMEZONE=Europe/Berlin
# Wie oft (Sekunden) der Hintergrund-Thread prueft, ob ein Platz faellig ist.
POLL_INTERVALL_SEKUNDEN=20

# --- Absicherung des MCP-Endpunkts ---
# Langes zufaelliges Geheimnis, das Claude beim Verbinden mitschicken muss.
# Erzeugen z.B. mit: openssl rand -hex 32
MCP_AUTH_TOKEN=hier-langes-zufaelliges-token-eintragen

# Lokaler Port, den docker-compose published. Muss sich von den Ports der
# anderen Ida-*-Container auf demselben Server unterscheiden.
MCP_PORT=8031

# --- Erinnerungs-Plaetze ---
# Beliebig viele, komplett unabhaengige Plaetze -- der Server erkennt beim
# Start SELBST, wie viele es gibt, einfach an der Anzahl vollstaendig
# befuellter REMINDER_SLOT_<N>_ROUTINE_ID/_API_KEY-Paare. Kein Limit
# irgendwo einstellen, kein docker-compose.yml anfassen -- einfach nach
# demselben Muster weitere Paare anhaengen (Nummerierung darf auch Luecken
# haben).
#
# Jeder Platz braucht einen eigenen claude.ai-Routinen-API-Trigger
# (routine_id + Bearer-Token), angelegt unter claude.ai/code/routines ->
# jeweilige Routine -> Einstellungen -> API-Trigger hinzufuegen. ALLE
# Routinen koennen denselben, ganz generischen System-Prompt haben (siehe
# README) -- die eigentliche Aufgabe kommt zur Laufzeit aus
# erinnerung_erstellen, nicht aus der Routine selbst.
REMINDER_SLOT_1_ROUTINE_ID=trig_hier-platz-1-routine-id-eintragen
REMINDER_SLOT_1_API_KEY=sk-ant-oat01-hier-platz-1-api-key-eintragen

REMINDER_SLOT_2_ROUTINE_ID=
REMINDER_SLOT_2_API_KEY=

REMINDER_SLOT_3_ROUTINE_ID=
REMINDER_SLOT_3_API_KEY=

# ... beliebig weiter mit REMINDER_SLOT_4, _5, usw. nach demselben Muster.

# --- Nur fuer docker-compose (Image-Referenz aus GHCR) ---
GITHUB_OWNER=l8tenever
IMAGE_TAG=latest
